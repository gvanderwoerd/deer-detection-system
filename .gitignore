# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Virtual Environment
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
*.log.*
logs/

# Backup files
*.backup.*
*.bak
*.old
backups/

# Detection images - privacy: local only, not in git
# Camera footage should remain private and not be pushed to GitHub
server/detections/**/*.jpg
server/detections/**/*.png

# Allow detection metadata (JSON logs) in camera subdirectories - no privacy concerns
!server/detections/**/detections.json

# But ignore the top-level runtime file
server/detections/detections.json

# Runtime
*.pid

# PlatformIO
.pio/
.pioenvs/
.piolibdeps/

# Model files (too large for git)
*.pt

# Environment variables and credentials
.env
server/tinytuya.json

# OS
.DS_Store
Thumbs.db
